# Copy to .env (gitignored) and fill in. Already-set environment variables take precedence.

# Model: codex:<model> uses your ChatGPT subscription via the Codex backend.
# Other specs go to init_chat_model and need that provider's API key, e.g. openai:gpt-... + OPENAI_API_KEY.
LAB_MODEL=codex:gpt-6-sol
# Pi's login file (read-only; Pi refreshes it). Run `pi` and log in to OpenAI Codex if it is missing or expired.
CODEX_AUTH_FILE=~/.pi/agent/auth.json

# Web search
TAVILY_API_KEY=tvly-****

# LangSmith tracing (optional)
LANGSMITH_API_KEY=lsv2_****
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=research-lab
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
